# Copier ce fichier vers .env et renseigner les valeurs du projet Supabase.
# Ces variables sont exposees au navigateur (prefixe VITE_) : n'y mettre que
# l'URL du projet et la cle anon publique, jamais la cle service_role.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique
